local PlayerRows = {}

local function rebuildPlayerList()
	for _, r in pairs(PlayerRows) do r.row:Destroy() end
	PlayerRows = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl ~= LP then
			local row = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = Row,
				Text = "", AutoButtonColor = false, BorderSizePixel = 0,
			}, PlayerScroll)
			corner(row, 4)
			local lbl = new("TextLabel", {
				Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(6, 0),
				BackgroundTransparency = 1, Font = Enum.Font.Gotham,
				TextSize = 11, TextColor3 = TextCol, TextXAlignment = Enum.TextXAlignment.Left,
				Text = pl.Name,
			}, row)
			PlayerRows[pl] = { row = row, lbl = lbl }
			row.MouseButton1Click:Connect(function()
				Config.ESP.Ignored[pl] = not Config.ESP.Ignored[pl]
				row.BackgroundColor3 = Config.ESP.Ignored[pl] and Color3.fromRGB(24, 24, 32) or Row
				lbl.TextTransparency = Config.ESP.Ignored[pl] and 0.5 or 0
			end)
		end
	end
end

Players.PlayerAdded:Connect(function() task.wait(0.4); rebuildPlayerList() end)
Players.PlayerRemoving:Connect(function(pl)
	if PlayerRows[pl] then PlayerRows[pl].row:Destroy(); PlayerRows[pl] = nil end
end)
rebuildPlayerList()


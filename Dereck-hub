--=====================================================================
-- HELPERS
--=====================================================================
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(obj, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, obj)
end

local function stroke(obj, col, thick)
	return new("UIStroke", { Color = col or Color3.fromRGB(55, 55, 72), Thickness = thick or 1 }, obj)
end

local function getRole(pl)
	local char = pl.Character
	local bp   = pl:FindFirstChildOfClass("Backpack")
	local function has(n)
		return (char and char:FindFirstChild(n)) or (bp and bp:FindFirstChild(n))
	end
	if has("Knife") then return "Murderer" end
	if has("Gun")   then return "Sheriff"  end
	return "Innocent"
end


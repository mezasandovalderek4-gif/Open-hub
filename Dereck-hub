local function makePage(name, icon)
	local page = new("ScrollingFrame", {
		Name = name, Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = Accent,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, Content)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, page)
	new("UIPadding", { PaddingBottom = UDim.new(0, 8) }, page)
	Pages[name] = page

	local btn = new("TextButton", {
		Size = UDim2.new(1, -14, 0, 32), BackgroundColor3 = Row,
		BackgroundTransparency = 1, Text = "  " .. icon .. "  " .. name,
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Color3.fromRGB(150, 150, 172),
		AutoButtonColor = false, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left,
	}, Sidebar)
	corner(btn, 6)
	TabBtns[name] = btn

	btn.MouseButton1Click:Connect(function()
		if ActiveTab then
			Pages[ActiveTab].Visible = false
			TweenService:Create(TabBtns[ActiveTab], TweenInfo.new(0.15), {
				BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(150, 150, 172) }):Play()
		end
		ActiveTab = name
		Pages[name].Visible = true
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundTransparency = 0, TextColor3 = Color3.new(1, 1, 1) }):Play()
		btn.BackgroundColor3 = Accent
	end)

	return page
end


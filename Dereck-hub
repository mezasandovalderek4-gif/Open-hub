local notifyHolder

local function notify(text, col)
	if not notifyHolder then return end
	local f = new("Frame", {
		Size = UDim2.fromOffset(260, 34),
		BackgroundColor3 = Panel, BorderSizePixel = 0,
		BackgroundTransparency = 1,
	}, notifyHolder)
	corner(f, 6)
	stroke(f, col or Accent, 1)

	local bar = new("Frame", {
		Size = UDim2.new(0, 3, 1, -12), Position = UDim2.fromOffset(8, 6),
		BackgroundColor3 = col or Accent, BorderSizePixel = 0,
	}, f)
	corner(bar, 2)

	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -22, 1, 0), Position = UDim2.fromOffset(16, 0),
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
		TextSize = 12, TextColor3 = TextCol, TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	}, f)

	TweenService:Create(f, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
	task.delay(2.6, function()
		TweenService:Create(f, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(lbl, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
		task.wait(0.3)
		f:Destroy()
	end)
end


		for pl, r in pairs(PlayerRows) do
			if pl.Character then
				r.lbl.TextColor3 = RoleColor[getRole(pl)]
				r.lbl.Text = pl.Name .. "  ·  " .. getRole(pl)
			end
		end
	end
end)


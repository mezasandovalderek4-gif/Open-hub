end

local function addToggle(parent, text, default, callback)
	local row = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Row,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0,
	}, parent)
	corner(row, 6)

	new("TextLabel", {
		Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
		TextSize = 12, TextColor3 = TextCol, TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	}, row)

	local track = new("Frame", {
		Size = UDim2.fromOffset(34, 18), Position = UDim2.new(1, -44, 0.5, -9),
		BackgroundColor3 = Color3.fromRGB(50, 50, 66), BorderSizePixel = 0,
	}, row)
	corner(track, 9)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(2, 2),
		BackgroundColor3 = Color3.fromRGB(240, 240, 248), BorderSizePixel = 0,
	}, track)
	corner(knob, 7)

	local state = default or false
	local function render()
		TweenService:Create(track, TweenInfo.new(0.14), {
			BackgroundColor3 = state and Accent or Color3.fromRGB(50, 50, 66) }):Play()
		TweenService:Create(knob, TweenInfo.new(0.14), {
			Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2) }):Play()
	end

	row.MouseButton1Click:Connect(function()
		state = not state
		render()
		callback(state)
	end)
	render()

	return {
		Set = function(v) state = v; render(); callback(v) end,
		Get = function() return state end,
	}
end

local function addSlider(parent, text, min, max, default, callback)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Row, BorderSizePixel = 0,
	}, parent)
	corner(row, 6)

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 22), Position = UDim2.fromOffset(10, 4),
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
		TextSize = 12, TextColor3 = TextCol, TextXAlignment = Enum.TextXAlignment.Left,
		Text = text,
	}, row)

	local valLbl = new("TextLabel", {
		Size = UDim2.fromOffset(50, 22), Position = UDim2.new(1, -58, 0, 4),
		BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
		TextSize = 12, TextColor3 = Accent, TextXAlignment = Enum.TextXAlignment.Right,
		Text = tostring(default),
	}, row)

	local bar = new("Frame", {
		Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 1, -16),
		BackgroundColor3 = Color3.fromRGB(48, 48, 62), BorderSizePixel = 0,
	}, row)
	corner(bar, 3)

	local fill = new("Frame", {
		Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = Accent, BorderSizePixel = 0,
	}, bar)
	corner(fill, 3)

	local dragging = false
	local function setFromX(px)
		local rel = math.clamp((px - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		local val = math.floor(min + (max - min) * rel + 0.5)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		valLbl.Text = tostring(val)
		callback(val)
	end

	bar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setFromX(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local function addButton(parent, text, callback)
	local b = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Row,
		Text = text, Font = Enum.Font.GothamMedium, TextSize = 12,
		TextColor3 = TextCol, AutoButtonColor = false, BorderSizePixel = 0,
	}, parent)
	corner(b, 6)
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = Accent }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = Row }):Play()
	end)
	b.MouseButton1Click:Connect(callback)
	return b
end

